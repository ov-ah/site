:8080 {
	@api_post {
		method POST
		path /register* /login* /logout*
	}
	handle @api_post {
		reverse_proxy 127.0.0.1:3000
	}

	handle /ws* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /history* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /me* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * ./frontend
		file_server
	}
}
